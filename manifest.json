{
  "manifest_version": 3,
  "name": "Better Claude",
  "version": "0.9.0",
  "description": "Improvements for Claude.ai: automatic RTL alignment for Hebrew and Arabic content in chats.",
  "author": "Assaf Tzur-El",
  "homepage_url": "https://github.com/AssafTzurEl/better-claude",

  "browser_specific_settings": {
    "gecko": {
      "id": "better-claude@pashut.co.il",
      "strict_min_version": "109.0"
    }
  },

  "content_scripts": [
    {
      "matches": ["https://claude.ai/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}